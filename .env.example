# Copy to .env.local (gitignored). Leave GOOGLE_APPLICATION_CREDENTIALS_JSON
# unset to run the API in mock-data mode.

# Full service-account JSON on one line (set in Vercel project env vars).
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Fully-qualified dataset, e.g. my-gcp-project.cs_warehouse
BQ_DATASET=
# Optional: override where Server Components reach the Python API.
API_BASE_URL=

# --- Proof of Value (PoV) workspace ---
# Service account that can write to the cs_pov dataset ONLY (full JSON, one line).
POV_GOOGLE_CREDENTIALS_JSON=
POV_BQ_DATASET=cs_pov
# Google OAuth 2.0 Web client ID used to verify staff sign-in tokens.
GOOGLE_OAUTH_CLIENT_ID=
# Local development only: skips Google sign-in and acts as this user. Ignored on Vercel.
AUTH_DEV_EMAIL=
